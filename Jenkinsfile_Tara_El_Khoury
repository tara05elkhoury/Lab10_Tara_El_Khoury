pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                bat 'python -m venv venv'
                bat 'venv\\Scripts\\python.exe -m pip install -r requirements.txt'
            }
        }

        stage('Lint') {
            steps {
                bat 'venv\\Scripts\\python.exe -m flake8 app.py'
            }
        }

        stage('Test') {
            steps {
                bat 'venv\\Scripts\\python.exe -m pytest'
            }
        }

        stage('Coverage') {
            steps {
                bat 'venv\\Scripts\\python.exe -m coverage run --source=app -m pytest'
                bat 'venv\\Scripts\\python.exe -m coverage report -m'
                bat 'venv\\Scripts\\python.exe -m coverage xml'
            }
        }

        stage('Security Scan') {
            steps {
                bat 'venv\\Scripts\\python.exe -m bandit app.py deploy.py -f txt -o bandit-report.txt'
                bat 'type bandit-report.txt'
            }
        }

        stage('Deploy') {
            steps {
                bat 'venv\\Scripts\\python.exe deploy.py'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'coverage.xml, bandit-report.txt',
                             allowEmptyArchive: true
            cleanWs()
        }
    }
}